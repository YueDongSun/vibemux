{
  "name": "vibemux_web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "vite --config vite_config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build --config vite_config.ts",
    "test": "node --experimental-strip-types --test tests/presentation_policy_test.ts tests/cache_policy_test.ts tests/console_policy_test.ts",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0"
  }
}
