{
  "name": "vibemux_desktop_ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "vite --config vite_config.ts --port 5180 --strictPort",
    "dev_fixture": "vite --config vite_config.ts --port 5180 --strictPort --mode fixture",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build --config vite_config.ts",
    "test": "node --experimental-strip-types --test tests/fixture_guard_test.ts",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.4",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
