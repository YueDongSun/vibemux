# Python environments and tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Rust build output
/target/

# VibeMux local runtime state
/.vibemux/
*.pid
*.sock
*.pipe
*.writer.lock

# Local agent and provider configuration
/.claude/
/.codex/
/.grok/
/.cc-switch/
/.config/opencode/

# Credentials and machine-local secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
/credentials/
/secrets/

# Local databases and SQLite sidecars
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Probe, support-bundle, and terminal capture output
/probe_output/
/support_bundles/
/probe_report.json
/vibemux_probe_report*.json
/frontend_snapshot*.txt
*.har
*.cast
*.ansi

# Logs and crash output
*.log
*.trace
